# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection URI (Choose one: Local MongoDB or MongoDB Atlas)
# For Local MongoDB Community Server:
MONGO_URI=mongodb://127.0.0.1:27017/postify
# For MongoDB Atlas:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.ynu5nzg.mongodb.net/postify?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=your_jwt_secret_key_here

# Frontend Client URL (for CORS in production or custom ports)
CLIENT_URL=http://localhost:5173

# Cloudinary Credentials (Required for image/video upload)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Google Gemini API Key (Optional, for AI caption generation)
GEMINI_API_KEY=your_gemini_api_key
